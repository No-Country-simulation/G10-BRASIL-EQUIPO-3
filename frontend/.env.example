# Fonte de dados. Dados simulados SÓ são usados com VITE_USE_MOCK=true (explícito).
# Ausente ou qualquer outro valor = API real (sem fallback silencioso para mocks).
# Com o backend rodando (uvicorn app.main:app --port 8000), use VITE_USE_MOCK=false.
VITE_USE_MOCK=false

# Base da API real. Padrão "/api/v1" (o Vite faz proxy de /api para VITE_PROXY_TARGET em desenvolvimento;
VITE_API_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:8000

# Login. Use true quando a rota existir (ou com VITE_USE_MOCK=true para a demo).
# Em modo demonstração (VITE_USE_MOCK=true) o login é simulado (revisor@mediflow.demo / mediflow123).
VITE_AUTH_ENABLED=false