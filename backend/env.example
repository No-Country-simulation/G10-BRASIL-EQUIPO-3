# MediFlow — variáveis de ambiente (copie para .env; NUNCA versione o .env com valores reais)

APP_ENV=development            # development | test | production

# --- Provedor de IA ---
# "mock" = provedor simulado (dados de teste; não faz avaliação clínica real).
# "gemini" exige LLM_MODEL e LLM_API_KEY.
LLM_PROVIDER=mock
LLM_MODEL=                     # nome do modelo Gemini Flash: confirmar na documentação oficial
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# --- Regra de confiança ---
CONFIDENCE_THRESHOLD=0.80      # entre 0 e 1

# --- Armazenamento ---
STORAGE_BACKEND=mock           # mock | oci
OCI_NAMESPACE=
OCI_REGION=
OCI_BUCKET=
OCI_CONFIG_PROFILE=DEFAULT

# --- Limites de ingestão ---
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=30
