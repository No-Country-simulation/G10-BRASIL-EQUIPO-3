# MediFlow — variáveis de ambiente (copie para .env; NUNCA versione o .env com valores reais)

APP_ENV=development            # development | test | production

# --- Provedor de IA ---
# "mock" = provedor simulado (dados de teste; não faz avaliação clínica real).
# "gemini" exige LLM_MODEL e LLM_API_KEY.
# "groq" exige LLM_MODEL e GROQ_API_KEY; o modelo recomendado suporta visão e JSON Schema.
LLM_PROVIDER=mock
LLM_MODEL=qwen/qwen3.8-27b     # exemplo Groq; deixe em mock para não enviar documentos
LLM_API_KEY=
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=30

# --- Regra de confiança ---
CONFIDENCE_THRESHOLD=0.80      # entre 0 e 1
URGENCY_TERMS=["tep agudo","tromboembolismo pulmonar agudo","correlacao clinica urgente"]
HIGH_RISK_MEDICATIONS=[]       # lista depende de validação e decisão da equipe

# --- Armazenamento ---
# --- Armazenamento ---
STORAGE_BACKEND=mock
# mock | local | oci

# Diretorio usado apenas quando STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.mediflow_storage

OCI_NAMESPACE=
OCI_REGION=
OCI_BUCKET=
OCI_CONFIG_PROFILE=DEFAULT
OCI_NAMESPACE=
OCI_REGION=
OCI_BUCKET=
OCI_CONFIG_PROFILE=DEFAULT

# --- Limites de ingestão ---
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=30
