# Copie para deploy/oci/.env no servidor; este arquivo não contém segredos.
# Diretório OCI no host Linux, contendo config e chave privada.
OCI_CONFIG_DIR=/opt/mediflow/secrets/oci
OCI_CONFIG_PROFILE=DEFAULT

# O Compose usa o mesmo valor no frontend e na API para evitar divergência.
# O backend também precisa de AUTH_SECRET e AUTH_USERS configurados em backend/.env.
AUTH_ENABLED=true
VITE_MAX_UPLOAD_MB=10

# Padrão local seguro: somente a própria máquina acessa em http://localhost:8080.
# No servidor OCI, altere para WEB_BIND_ADDRESS=0.0.0.0 e WEB_PORT=80 após
# restringir a porta 80 no NSG aos IPs autorizados.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
